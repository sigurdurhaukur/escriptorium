, 1328], [1464, 1328], [1464, 1316], [1464, 1300], [1458, 1294]], "baseline": [[541, 1316], [1464, 1316]], "font_size": 29, "line_width": 923}, {"text": "scraping knives for filleting machines\u201c. The aim of the projects was to develop", "boundary": [[541, 1350], [541, 1360], [1460, 1356], [1461, 1346], [1458, 1326], [540, 1329], [541, 1350]], "baseline": [[541, 1350], [1461, 1346]], "font_size": 25, "line_width": 921}, {"text": "and build a computer guided device to control movements of scraping knives in", "boundary": [[541, 1381], [541, 1391], [1461, 1389], [1463, 1378], [1459, 1359], [540, 1360], [541, 1381]], "baseline": [[541, 1381], [1463, 1378]], "font_size": 24, "line_width": 923}, {"text": "the F-189-PLC filleting machine from Fiskve\u0301lar. The goal was to increase", "boundary": [[541, 1412], [541, 1422], [613, 1422], [622, 1429], [623, 1429], [625, 1429], [626, 1429], [658, 1422], [671, 1429], [673, 1429], [674, 1429], [722, 1422], [751, 1429], [752, 1429], [753, 1430], [822, 1430], [822, 1429], [823, 1429], [825, 1429], [831, 1424], [836, 1429], [838, 1429], [839, 1429], [840, 1429], [931, 1422], [947, 1429], [948, 1429], [949, 1429], [1004, 1422], [1022, 1429], [1024, 1429], [1025, 1429], [1125, 1422], [1408, 1429], [1409, 1429], [1464, 1421], [1464, 1412], [1464, 1393], [541, 1391], [541, 1412]], "baseline": [[541, 1412], [1464, 1412]], "font_size": 29, "line_width": 923}, {"text": "filleting yield and make it possible to fillet smaller fish than has been possible", "boundary": [[541, 1444], [541, 1460], [1464, 1460], [1464, 1444], [1464, 1424], [541, 1424], [541, 1444]], "baseline": [[541, 1444], [1464, 1444]], "font_size": 27, "line_width": 923}, {"text": "before.", "boundary": [[541, 1474], [540, 1493], [627, 1493], [628, 1477], [627, 1456], [541, 1454], [541, 1474]], "baseline": [[541, 1474], [628, 1477]], "font_size": 29, "line_width": 88}, {"text": "Measuring filleting yield of the machine after it has been fitted with the new", "boundary": [[543, 1524], [543, 1535], [1463, 1535], [1463, 1524], [1463, 1502], [543, 1495], [543, 1524]], "baseline": [[543, 1524], [1463, 1524]], "font_size": 30, "line_width": 920}, {"text": "device shows that yield has improved by 0,81%. Unfortunately the success of", "boundary": [[541, 1556], [541, 1568], [1460, 1565], [1461, 1554], [1458, 1529], [540, 1535], [541, 1556]], "baseline": [[541, 1556], [1461, 1554]], "font_size": 29, "line_width": 921}, {"text": "the machine when filleting very small fish (-0,7 kg) has not yet been carried out", "boundary": [[541, 1589], [541, 1603], [1461, 1600], [1463, 1586], [1459, 1565], [540, 1567], [541, 1589]], "baseline": [[541, 1589], [1463, 1586]], "font_size": 28, "line_width": 923}, {"text": "due to lack of raw material.", "boundary": [[540, 1620], [540, 1636], [858, 1636], [858, 1620], [858, 1599], [540, 1599], [540, 1620]], "baseline": [[540, 1620], [858, 1620]], "font_size": 27, "line_width": 318}, {"text": "The new device appears to guide the knives better along the cutting curve and", "boundary": [[543, 1669], [543, 1684], [1463, 1684], [1463, 1669], [1463, 1647], [543, 1641], [543, 1669]], "baseline": [[543, 1669], [1463, 1669]], "font_size": 32, "line_width": 920}, {"text": "allow them to cut closer to the bones. Improved manoeuvrability of the knives is", "boundary": [[541, 1700], [541, 1717], [1460, 1716], [1460, 1700], [1460, 1680], [541, 1680], [541, 1700]], "baseline": [[541, 1700], [1460, 1700]], "font_size": 27, "line_width": 919}, {"text": "also reducing strain on the flesh of the fish.", "boundary": [[541, 1733], [541, 1749], [1029, 1747], [1029, 1730], [1025, 1710], [540, 1711], [541, 1733]], "baseline": [[541, 1733], [1029, 1730]], "font_size": 29, "line_width": 489}, {"text": "English keywords:", "boundary": [[209, 1943], [209, 1963], [484, 1960], [484, 1938], [482, 1919], [430, 1910], [428, 1910], [427, 1910], [408, 1917], [276, 1911], [275, 1911], [274, 1911], [272, 1911], [263, 1917], [220, 1912], [219, 1912